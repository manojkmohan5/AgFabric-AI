# Copy to .env and set JWT_SECRET. The app refuses to start without it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

DATABASE_URL=postgresql+psycopg://agfabric:agfabric@localhost:5432/agfabric

# Password for every seeded demo user. Dev only.
SEED_PASSWORD=agfabric-dev

# Object storage. Defaults match the MinIO container in docker-compose.yml.
# For real AWS S3: clear S3_ENDPOINT_URL and set real credentials.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=agfabric
S3_SECRET_KEY=agfabric-dev
S3_BUCKET=agfabric-documents

QDRANT_URL=http://localhost:6333

# OpenAI. Leave OPENAI_API_KEY blank and EMBEDDING_PROVIDER=auto falls back to a
# deterministic local fake, so the app and its tests run at $0 with no key.
# Set the key to use text-embedding-3-small for real.
# Switching providers changes vector dimensions -> delete the Qdrant collection
# and POST /search/reindex.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=auto
LLM_PROVIDER=auto
# Cheapest chat model available: $0.10/$0.40 per Mtok, vs gpt-4o-mini at
# $0.15/$0.60 and gpt-5.4-nano at $0.20/$1.25. Answers here are extractive over
# retrieved context, and any SQL it writes is validated before it runs, so the
# smallest model is a fit rather than a compromise. Measured ~$0.00015/query.
# Rates per model live in llm.MODEL_PRICES — add an entry when changing this, or
# the audit trail and the daily cap both price the call at a penalty rate.
OPENAI_CHAT_MODEL=gpt-4.1-nano

# Image OCR via the vision API — no local model, no tesseract binary.
OCR_PROVIDER=auto
OPENAI_VISION_MODEL=gpt-4.1-nano

# Browser origins allowed to call the API. Comma-separated, no wildcards.
CORS_ORIGINS=http://localhost:3000

# Inbound webhook signing key. Unset means /webhooks/* refuses everything rather
# than accepting unsigned writes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Set to move background agents onto Celery. This also disables the API's
# in-process scheduler so nothing runs twice. Leave blank to use the in-process
# scheduler and skip the broker entirely.
CELERY_BROKER_URL=

# If set, /metrics requires Authorization: Bearer <this>. Prometheus sends it via
# bearer_token in its scrape config. Blank leaves the endpoint open (fine locally).
METRICS_TOKEN=

# --------------------------------------------------------------- standing up
# Seeding DROPS EVERY TABLE, so `python -m app.seed` refuses to run unless this
# is explicitly true. Never set it on an instance holding real data.
ALLOW_DESTRUCTIVE_SEED=false

# The no-seed path in. On a freshly migrated, empty database the API creates this
# one exec account at startup, and you provision the rest through POST
# /admin/users and POST /provision/*. Ignored the moment any user exists, so it
# cannot be used to add an account or reset a password later.
# Clear the password from the environment once you have signed in and changed it.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Minimum length enforced on every password the API sets.
MIN_PASSWORD_LENGTH=12

# True lists the seeded demo accounts on the login page. Must be false anywhere
# real, or the sign-in page advertises credentials that may exist.
DEMO_MODE=false

# ----------------------------------------------------------------- live feeds
# auto -> live when the network is reachable, fake otherwise. Force `fake` to
# guarantee no outbound calls (what CI uses), or `live` to fail loudly instead of
# silently falling back.
MARKET_PROVIDER=auto
FEEDS_PROVIDER=auto
ENABLE_LIVE_MARKET=true
ENABLE_LIVE_FEEDS=true

# ---------------------------------------------------------------- cost guards
# Only bite when a real OPENAI_API_KEY is set; the fake provider costs $0. The cap
# sums audit_logs.cost_usd over a rolling 24h and returns 503 once reached, so a
# runaway loop cannot spend the month's budget overnight.
ENABLE_SPEND_CAP=true
DAILY_SPEND_CAP_USD=10.0

# Per-user /query throttle: requests allowed per window, and the window itself.
QUERY_RATE_LIMIT=30
QUERY_RATE_WINDOW_SECONDS=300
